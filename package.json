{
  "name": "aksaraku",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*' && cp -r public/. dist/",
    "start": "NODE_ENV=production bun src/index.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "fp-ts": "^2.16.11",
    "i18next": "^26.4.2",
    "pixi.js": "^8.21.0",
    "react": "^19",
    "react-dom": "^19",
    "react-i18next": "^17.0.14",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
