{
  "name": "aksaraku",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "NODE_ENV=production bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --splitting --env='BUN_PUBLIC_*' && cp -r public/. dist/ && bun scripts/build-sw.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "dexie": "^4.4.6",
    "fp-ts": "^2.16.11",
    "i18next": "^26.4.2",
    "pixi.js": "^8.21.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.14",
    "three": "^0.186.0",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "^0.186.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
